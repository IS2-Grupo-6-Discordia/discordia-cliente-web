{
  "expo": {
    "name": "Discordia",
    "slug": "discordia-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "discordia",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.discordia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1620"
      },
      "package": "com.discordia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "115019a3-8459-4818-96f9-2524b91e9b92"
      }
    }
  }
}
