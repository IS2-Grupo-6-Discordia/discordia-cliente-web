{
  "expo": {
    "name": "Discordia",
    "slug": "discordia-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "discordia",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.discordia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1620"
      },
      "package": "com.discordia.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "discordia-cliente-web.vercel.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Discordia necesita acceso a tu cámara para compartir video en las llamadas.",
          "microphonePermission": "Discordia necesita acceso a tu micrófono para participar de las llamadas."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.357428623304-lnu4vkc3psjuocv2m984ic4tqglbpfes"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "115019a3-8459-4818-96f9-2524b91e9b92"
      }
    }
  }
}
