{
  "expo": {
    "name": "Discordia",
    "slug": "discordia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "discordia",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.discordia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1620"
      },
      "package": "com.discordia.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "discordia-cliente-web.vercel.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f459e802-fd86-4063-b49c-201875eea4f4"
      }
    },
    "owner": "rbrunodevs-team"
  }
}
